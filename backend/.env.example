# Cloudflare R2 Storage Configuration for RomanceToon
# Obtain these from: Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=romancetoon-chapters
R2_PUBLIC_DOMAIN=https://cdn.romancetoon.com

# Target Data Directory (Default looks at ./data or custom path)
DATA_SOURCE_DIR=./data
