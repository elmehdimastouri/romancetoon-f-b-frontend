# ==============================================================================
# RomanceToon Backend Environment Configuration Template
# Copy this file to .env and customize values for your deployment
# NEVER commit the actual .env file with secrets into version control!
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=production

# ------------------------------------------------------------------------------
# Authentication & Security Secrets
# [CRITICAL SECURITY REQUIREMENT]:
# In production (NODE_ENV=production), the server will refuse to start if:
# 1. ADMIN_PASSWORD is missing, < 8 characters, or matches default/weak words.
# 2. AUTH_SECRET is missing, < 16 characters, or matches default/weak words.
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_very_strong_admin_password_min_8_chars
AUTH_SECRET=generate_a_random_32_to_64_character_secret_key_here

# ------------------------------------------------------------------------------
# Hostinger MySQL Database Configuration
# Obtain credentials from Hostinger cPanel / hPanel -> Databases -> MySQL Databases
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# ------------------------------------------------------------------------------
# Cloudflare R2 Storage Configuration
# Obtain credentials from Cloudflare Dashboard -> R2 Object Storage -> Manage API Tokens
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=romancetoon-chapters
R2_PUBLIC_DOMAIN=https://cdn.romancetoon.com

# ------------------------------------------------------------------------------
# Target Data Directory (used by chapter batch importer script)
# ------------------------------------------------------------------------------
DATA_SOURCE_DIR=./data
